{
  "name": "stlbombers-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "init:hard": "rm -rf ./node_modules && rm -rf ./package-lock.json && npm i",
    "develop": "concurrently --kill-others \"next dev\" \"./scripts/mobiledev.sh\"",
    "dev": "next dev",
    "build": "npm run lint:fix && next build",
    "start": "next start",
    "prod": "next build && next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretty": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.726.0",
    "@chakra-ui/icons": "^2.0.1",
    "@chakra-ui/react": "^2.1.2",
    "@emotion/react": "^11.9.0",
    "@emotion/styled": "^11.8.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@gsap/react": "^2.1.1",
    "@paypal/react-paypal-js": "^8.1.2",
    "date-fns": "^2.28.0",
    "framer-motion": "^6.3.3",
    "gsap": "^3.12.5",
    "hamburger-react": "^2.5.0",
    "lodash": "^4.17.21",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.7.1",
    "react-markdown": "^8.0.3",
    "react-share": "^4.4.1",
    "remark-gfm": "^3.0.1",
    "sass": "^1.54.9",
    "styled-components": "^5.3.5",
    "use-mask-input": "^3.4.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^8.16.0",
    "eslint-config-next": "^14.2.33",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^2.8.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix"
  }
}
